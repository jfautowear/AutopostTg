# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@jfnetworknet

# Admin bot — HANYA username ini yang boleh command (/test, /postnow, jadwal)
ADMIN_TELEGRAM_USERNAME=jfnetworkindo

# Grup private testing untuk /test
# Link invite: https://t.me/+xqVu_zt1_HpmMWNl
# WAJIB isi ID numerik (contoh: -1001234567890), BUKAN link invite.
# Cara: tambahkan bot ke grup → forward 1 pesan grup ke @userinfobot / @getidsbot
TEST_CHAT_ID=

# OKX Web3 DEX referral (diacak otomatis tiap post)
# https://web3.okx.ac/join/JFNETWORK
# https://web3.okx.ac/join/OKXDEXJF
TELEGRAM_FORWARD_ENABLED=true
TELEGRAM_FORWARD_CHAT_ID=@caricuanhp
TELEGRAM_FORWARD_THREAD_ID=80483

# Kategori konten: spot | airdrop | auto (auto = bergantian tiap jam WIB)
POST_CATEGORY=auto

# Jadwal utama ada di config/schedule.json (bisa diubah via chat bot)
CRON_TIMEZONE=Asia/Jakarta

# AI — hemat kredit
# free = Groq → OpenRouter free → fallback lokal (TIDAK pakai Gemini/paid)
# auto = free dulu, lalu paid jika gratis gagal
# paid = OpenRouter paid / Gemini dulu
AI_PROVIDER=free
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b

OPENROUTER_API_KEY=your_openrouter_api_key
# Maks 2 model free (dipisah koma)
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free,openrouter/free
OPENROUTER_MODEL=google/gemini-2.5-flash

# Hanya dipakai jika AI_PROVIDER=auto atau paid
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Gambar: Pollinations saja (gratis, tanpa key)
POLLINATIONS_ENABLED=true

# Batas aman channel gratis
POST_LANGUAGE=id
MAX_CAPTION_CHARS=700
MAX_HOOK_CHARS=60
MAX_INFO_CHARS=220
MAX_CTA_CHARS=80

RUN_ON_START=false

# === Top Aktif Mingguan (grup caricuanhp) ===
# Default: GitHub Actions poll 2×/hari (08 & 20 WIB) + Sabtu pagi umumkan
# ACTIVITY_SOURCE=gha → jangan biarkan npm start ON terus (bentrok getUpdates)
# ACTIVITY_SOURCE=local → PC yang mencatat (set juga ACTIVITY_LOCAL_CRON=true bila perlu)
ACTIVITY_ENABLED=true
ACTIVITY_SOURCE=gha
ACTIVITY_LOCAL_CRON=false
ACTIVITY_CHAT_ID=@caricuanhp
# Topik pengumuman Top 10: https://t.me/caricuanhp/65640
ACTIVITY_THREAD_ID=65640
WEEKLY_TOP_CRON=0 10 * * 6
ACTIVITY_WEIGHT_MESSAGE=2
ACTIVITY_WEIGHT_REACTION=1

{
  "name": "autopost-telegram-crypto",
  "version": "1.0.0",
  "description": "Auto-post crypto market updates from OKX & Bitget to Telegram",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "post:once": "node index.js --once",
    "post:force": "node index.js --once --force",
    "post:test": "node index.js --once --test",
    "commands": "node scripts/processCommands.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0"
  }
}

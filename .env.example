# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=@jfnetworknet

# Admin bot — HANYA username ini yang boleh command (/test, /postnow, jadwal)
ADMIN_TELEGRAM_USERNAME=jfnetworkindo

# Grup private testing untuk /test
# Link invite: https://t.me/+xqVu_zt1_HpmMWNl
# WAJIB isi ID numerik (contoh: -1001234567890), BUKAN link invite.
# Cara: tambahkan bot ke grup → forward 1 pesan grup ke @userinfobot / @getidsbot
TEST_CHAT_ID=

# Forward otomatis ke grup publik (https://t.me/caricuanhp/80483)
TELEGRAM_FORWARD_ENABLED=true
TELEGRAM_FORWARD_CHAT_ID=@caricuanhp
TELEGRAM_FORWARD_THREAD_ID=80483

# Sumber data & tombol affiliate: auto | okx | bitget
EXCHANGE_SOURCE=auto
# priority | random — pilih koin hot/viral
HOT_PICK_MODE=priority

# Jadwal utama ada di config/schedule.json (bisa diubah via chat bot)
CRON_TIMEZONE=Asia/Jakarta

# AI: gemini dulu, otomatis fallback ke openrouter jika kuota/kredit habis
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux-1-schnell

POLLINATIONS_ENABLED=true

# Batas aman channel gratis
POST_LANGUAGE=id
MAX_CAPTION_CHARS=700
MAX_HOOK_CHARS=60
MAX_INFO_CHARS=220
MAX_CTA_CHARS=80

RUN_ON_START=false
